# Personal Doctor AI — backend configuration.
# Copy to .env (setup.command does this automatically). NEVER commit .env.
# All values below are placeholders.

APP_ENV=development

# Secret used to sign session tokens (JWT). setup.command generates a random value.
JWT_SECRET=change-me-generated-by-setup

# Fernet master key used to encrypt stored OpenAI API keys at rest.
# Kept here (outside SQLite). setup.command generates a random value.
ENCRYPTION_KEY=change-me-generated-by-setup

# SQLite database location (relative to backend/)
DATABASE_URL=sqlite:///./data/personal_doctor_ai.db

# Medical document storage directory (relative to backend/)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# Session lifetime in minutes
ACCESS_TOKEN_MINUTES=720

# Frontend origin allowed by CORS (local only)
FRONTEND_ORIGIN=http://localhost:5173

# Default OpenAI model offered in Settings (users can change it)
DEFAULT_OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60

# Rate limits (requests per minute)
AUTH_RATE_LIMIT_PER_MIN=10
AI_RATE_LIMIT_PER_MIN=20
